[Plugin]
name = 车来了去广告[墨鱼版]
desc = 去除车来了App开屏广告、信息流广告等 (基于JQ)
author = @ddgksf2013
img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bus.png
homepage = https://t.me/ddgksf2021

[Rewrite]
# 开屏广告
^https?:\/\/api\.chelaile\.net\.cn\/advert\/ reject
^https?:\/\/api\.chelaile\.net\.cn\/goocity\/advert\/ reject
^https?:\/\/atrace\.chelaile\.net\.cn\/advert\/ reject
^https?:\/\/atrace\.chelaile\.net\.cn\/exhibit\?&adv_image reject
^https?:\/\/pic1\.chelaile\.net\.cn\/adv\/ reject

# 首页广告
^https?:\/\/api\.chelaile\.net\.cn\/tapi\/cardv2\/ reject
^https?:\/\/web\.chelaile\.net\.cn\/api\/advert\/ reject

# 详情页广告
^https?:\/\/api\.chelaile\.net\.cn\/tapi\/common\/ reject

[Script]
# 使用 JQ 语法过滤 (无需外部脚本)
# 逻辑：递归遍历 JSON，删除所有包含 adv_url 字段的对象
http-response ^https?:\/\/api\.chelaile\.net\.cn\/.* requires-body=true, tag=车来了净化, http-response-jq='walk(if type == "object" and .adv_url then empty else . end)'

[MitM]
hostname = web.chelaile.net.cn, api.chelaile.net.cn, atrace.chelaile.net.cn
